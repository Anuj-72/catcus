# Copy to backend/.env and change the password.
POSTGRES_USER=catcus
POSTGRES_PASSWORD=catcus_local_dev
POSTGRES_DB=catcus

# psycopg 3 driver, synchronous SQLAlchemy.
DATABASE_URL=postgresql+psycopg://catcus:catcus_local_dev@127.0.0.1:5432/catcus
TEST_DATABASE_URL=postgresql+psycopg://catcus:catcus_local_dev@127.0.0.1:5432/catcus_test

# SQLAlchemy pool. Ceiling per instance is size + max_overflow.
# Keep this small: a serverless deployment runs many instances in parallel,
# each holding its own pool, and the total must stay inside the database's
# connection budget. Behind a transaction-mode pooler, use the pooled URL.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
DB_POOL_USE_LIFO=true
DB_CONNECT_TIMEOUT=5

# HS256 signing and validation. JWT_SECRET must be 32+ characters and must
# match JWT_SECRET in the root .env.local. Generate one with:
# openssl rand -base64 32
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=catcus-api
JWT_AUDIENCE=catcus-web
ACCESS_TOKEN_TTL=3600
REMEMBER_TOKEN_TTL=2592000