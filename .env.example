# FastAPI auth service. Server-side only; the browser never calls it.
BACKEND_URL=http://127.0.0.1:8000

# Verifies backend-issued JWTs (HS256). Must be 32+ characters and identical to
# JWT_SECRET in backend/.env. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=catcus-api
JWT_AUDIENCE=catcus-web
