{
  "name": "catcus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "up": "npm run db:up && npm run backend:migrate && concurrently -k -n web,api -c blue,green \"npm run dev\" \"npm run backend:dev\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "backend:setup": "cd backend && python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'",
    "backend:migrate": "cd backend && .venv/bin/alembic upgrade head && .venv/bin/python -m scripts.seed",
    "backend:dev": "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "check:geometry": "node scripts/geometry-check.mjs",
    "check:functional": "node scripts/functional-check.mjs",
    "check:visual": "node scripts/visual-check.mjs",
    "check:responsive": "node scripts/responsive-check.mjs"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5"
  }
}
